{{!--
b:template-skin content (for Layout Mode)
@author zkreations
@see https://bloggercode-blogconnexion.blogspot.com/2014/06/tag-b-skin-b-template-skin.html
--}}
<b:template-skin><![CDATA[
  {{asset '~/blogger-admin-wp/main.min.css'}}

  body#layout .tools{display:flex}
  body#layout #tools{background-color:#e9ecec;border:0;margin-right:0;border-radius:5px}
  body#layout #tools .dropregion,body#layout #tools .layout-title,body#layout #tools .layout-widget-state,body#layout #tools h4{display:none}
  body#layout #tools .widget{margin:0;float:left}
  body#layout #tools .widget-wrap3{border:0;border-radius:5px}
  body#layout #tools .widget-content{padding:20px;background-size:24px;border:0;background-image:none;background-position:center;background-repeat:no-repeat}
  body#layout #tools .widget.Image{margin-right:5px}
  body#layout #tools .widget.Image .widget-content{background-image:url("https://www.gstatic.com/images/icons/material/system_gm/2x/image_grey600_24dp.png")}
]]></b:template-skin>

{{!--
Fonts
--}}
<Group description="Fonts">
  <!-- Fuente para el logo (Bricolage Grotesque) -->
  <Variable name="font.logo" description="Logo font" type="font" default="normal 400 1rem Bricolage Grotesque', sans-serif" value="normal 400 1rem 'Bricolage Grotesque', sans-serif"/>

  <!-- Fuente para los Títulos (Gloock) -->
  <Variable name="font.title" description="Title font" type="font" default="normal 400 1rem 'Gloock', serif" value="normal 400 1rem 'Gloock', serif"/>

  <!-- Fuente para el Cuerpo / Textos (Golos Text estándar) -->
  <Variable name="font.text" description="Text font" type="font" default="normal 400 1rem 'Golos Text', sans-serif" value="normal 400 1rem 'Golos Text', sans-serif"/>

  <!-- Fuente para la leyenda (Inter) -->
  <Variable name="font.leyenda" description="Leyenda font" type="font" default="normal 200 1.2rem 'Inter', sans-serif" value="normal 200 1.2rem 'Inter', sans-serif"/>

  <!-- Fuente para las citas biblicas -->
  <Variable name="font.biblical" description="Font of the biblical quote" type="font" default="normal 400 1rem 'Lora', serif" value="normal 400 1rem 'Lora', serif"/>
  <Variable name="font.biblical.italic" description="Font of the biblical quote Italic" type="font" default="italic 400 1rem 'Lora', serif" value="italic 400 1rem 'Lora', serif"/>

  <!-- Fuente para los bloques de código -->
  <Variable name="font.code" description="Font Code" type="font" default="normal 400 1rem 'Geist Mono', mono" value="normal 400 1rem 'Geist Mono', mono"/>
</Group>
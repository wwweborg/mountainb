<Group description="Colors">
    <!-- Color primario o de ecento -->
    <Variable name="primary" description="Primary Color" type="color" default="#006FFF" value="#006FFF"/>
    <Variable name="d.primary" description="Dark Primary Color" type="color" default="#4093FF" value="#4093FF"/>

    <!-- Color del logo, títulos y negritas -->
    <Variable name="m.t.color" description="Main Text Color" type="color" default="#171717" value="#171717"/>
    <Variable name="s.t.color" description="Secondary Text Color" type="color" default="#4A5565" value="#4A5565"/>

    <!-- Color de los párrafos -->
    <Variable name="d.m.t.color" description="Dark Main Text Color" type="color" default="#EDEDED" value="#EDEDED"/>
    <Variable name="d.s.t.color" description="Dark Secondary Text Color" type="color" default="#999CA1" value="#999CA1"/>

    <!-- Color de los iconos -->
    <Variable name="i.color" description="Icon Color" type="color" default="#111" value="#111"/>
    <Variable name="d.i.color" description="Dark Icon Color" type="color" default="#EEE" value="#EEE"/>

    <!-- Color del texto seleccionado -->
